{
  "name": "tanstack_start_ts",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:unit": "bun test src",
    "test:e2e": "playwright test",
    "test:db": "node scripts/run-db-regression.mjs",
    "test:a11": "bun run test:unit && bun run test:db",
    "test:financial": "bun test src/lib/person-ledger.test.ts",
    "test:market-value": "bun test src/lib/assets/market-value.test.ts",
    "test:sale-semantics": "bun test src/lib/assets/sale-semantics.test.ts",
    "test:route-perf": "bun test src/components/motion/RouteProgressBar.test.ts src/router.config.test.ts",
    "format": "prettier --write .",
    "android:add": "npx cap add android",
    "android:assets": "npx capacitor-assets generate --android",
    "android:sync": "bun run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "bun run android:sync && npx cap run android",
    "android:sync:prod": "CAP_ENV=production bun run android:prepare && CAP_ENV=production npx cap sync android",
    "android:debug": "bun run android:sync:prod && cd android && ./gradlew assembleDebug",
    "android:apk": "bun run android:sync:prod && cd android && ./gradlew assembleRelease",
    "android:aab": "bun run android:sync:prod && cd android && ./gradlew bundleRelease",
    "android:prepare": "bun run build && node scripts/prepare-android-web.mjs"
  },
